#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Ergo-L on a Corne Choc Pro.
 *
 * The keyboard does NOT emulate Ergo-L: it sends plain US key positions and
 * the Ergo-L driver installed on the operating system produces the actual
 * characters. This is the method recommended by ergol.org; emulating the
 * layout in firmware is explicitly discouraged.
 *
 * The EL_* defines below exist only to make this file readable. Each one
 * resolves to the US position that Ergo-L maps to that character - no
 * translation, no macros, no Unicode.
 */

/* Upper row */
#define EL_Q      Q       /* q */
#define EL_C      W       /* c */
#define EL_O      E       /* o */
#define EL_P      R       /* p */
#define EL_W      T       /* w */
#define EL_J      Y       /* j */
#define EL_M      U       /* m */
#define EL_D      I       /* d */
#define EL_1DK    O       /* 1DK - Ergo-L dead key */
#define EL_Y      P       /* y */

/* Home row */
#define EL_A      A       /* a */
#define EL_S      S       /* s */
#define EL_E      D       /* e */
#define EL_N      F       /* n */
#define EL_F      G       /* f */
#define EL_L      H       /* l */
#define EL_R      J       /* r */
#define EL_T      K       /* t */
#define EL_I      L       /* i */
#define EL_U      SEMI    /* u */

/* Lower row */
#define EL_Z      Z       /* z */
#define EL_X      X       /* x */
#define EL_DASH   C       /* -  (shifted: ?) */
#define EL_V      V       /* v */
#define EL_B      B       /* b */
#define EL_DOT    N       /* .  (shifted: :) */
#define EL_H      M       /* h */
#define EL_G      COMMA   /* g */
#define EL_COMMA  DOT     /* ,  (shifted: ;) */
#define EL_K      FSLH    /* k */

/* Punctuation reachable from the layers */
#define EL_SLASH  MINUS   /* /  (shifted: _) */
#define EL_EQUAL  EQUAL   /* =  (shifted: +) */

/* Layers */
#define BASE 0
#define NAV  1
#define SYS  2

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "ERGOL";
            // ---------------------------------------------------------------------------------------------
            // | TAB  |  q  |  c  |  o  |  p  |  w  |  PP  | VOL+ |  j  |  m  |  d  | 1DK |  y  | BSPC |
            // | ESC  |  a  |  s  |  e  |  n  |  f  | NEXT | VOL- |  l  |  r  |  t  |  i  |  u  | RET  |
            // | SHFT |  z  |  x  |  -  |  v  |  b  |             |  .  |  h  |  g  |  ,  |  k  | SHFT |
            //                    | ALT | CTRL | GUI |             | NAV | SPC | AGR |
            bindings = <
                &kp TAB   &kp EL_Q &kp EL_C &kp EL_O &kp EL_P &kp EL_W &kp C_PP   &kp C_VOL_UP &kp EL_J   &kp EL_M &kp EL_D &kp EL_1DK   &kp EL_Y &kp BSPC
                &kp ESC   &kp EL_A &kp EL_S &kp EL_E &kp EL_N &kp EL_F &kp C_NEXT &kp C_VOL_DN &kp EL_L   &kp EL_R &kp EL_T &kp EL_I     &kp EL_U &kp RET
                &kp LSHFT &kp EL_Z &kp EL_X &kp EL_DASH &kp EL_V &kp EL_B                      &kp EL_DOT &kp EL_H &kp EL_G &kp EL_COMMA &kp EL_K &kp RSHFT
                                             &kp LALT &kp LCTRL &kp LGUI                       &mo NAV    &kp SPACE &kp RALT
            >;
        };

        nav_layer {
            display-name = "NAVNUM";
            // ---------------------------------------------------------------------------------------------
            // | SYS  | TAB  | HOME | UP   | END  | PGUP |      |      |  /  |  7  |  8  |  9  |     |     |
            // |      | CAPS | LEFT | DOWN | RGHT | PGDN |      |      |  -  |  4  |  5  |  6  |  0  |     |
            // |      |      | VOL- | MUTE | VOL+ | STAB |             |  ,  |  1  |  2  |  3  |  .  |     |
            //                      |      |      |      |             |     |     |     |
            bindings = <
                &mo SYS &kp TAB  &kp HOME     &kp UP      &kp END      &kp PG_UP  &trans &trans &kp EL_SLASH &kp N7 &kp N8 &kp N9 &none  &trans
                &trans  &kp CAPS &kp LEFT     &kp DOWN    &kp RIGHT    &kp PG_DN  &trans &trans &kp EL_DASH  &kp N4 &kp N5 &kp N6 &kp N0 &trans
                &trans  &none    &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &kp LS(TAB)              &kp EL_COMMA &kp N1 &kp N2 &kp N3 &kp EL_DOT &trans
                                              &trans      &trans       &trans                  &trans       &trans &trans
            >;
        };

        sys_layer {
            display-name = "SYS";
            // ---------------------------------------------------------------------------------------------
            // | UNLK | F1 | F2  | F3  | F4  |      |  |  | BT0 | BT1 | BT2 | BT3 | BTCLR |     |
            // |      | F5 | F6  | F7  | F8  |      |  |  | OUT | USB | BLE | RGB |       |     |
            // | RST  | F9 | F10 | F11 | F12 | BOOT |     |     |     |     |     |       |     |
            //                   |     |     |      |     |     |     |     |
            bindings = <
                &studio_unlock &kp F1 &kp F2  &kp F3  &kp F4  &none       &trans &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3    &bt BT_CLR &trans
                &none          &kp F5 &kp F6  &kp F7  &kp F8  &none       &trans &trans &out OUT_TOG &out OUT_USB &out OUT_BLE &rgb_ug RGB_TOG &none      &trans
                &sys_reset     &kp F9 &kp F10 &kp F11 &kp F12 &bootloader               &none        &none        &none        &none           &none      &trans
                                              &trans  &trans  &trans                    &trans       &trans       &trans
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
